# Meemoo environment — copy to .env and fill in what you have.
# EVERYTHING here is optional unless marked otherwise. Missing credentials
# never crash startup; the subsystem that needs them degrades gracefully
# (no LLM key -> scripted check-ins; no Twilio -> simulated call screen).

# ---------------------------------------------------------------- LLM providers
# Any subset (or none). The brain routes across whichever are configured.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Local model server (offline fallback brain), e.g. http://localhost:11434
OLLAMA_URL=

# ------------------------------------------------- Twilio (DEMO CALLS ONLY)
# Behind the notifier adapter (Constitution Art. III §3). Without these,
# escalations log + show the simulated incoming-call screen in the UI.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------- Storage
# SQLite database file (directory is created on first run).
MEEMOO_DB_PATH=data/meemoo.db
# Fernet key for encrypting provider keys at rest. Leave blank: generated on
# first run (Phase 1). NEVER commit a real key.
MEEMOO_FERNET_KEY=

# ---------------------------------------------------------- Perception input
# webcam (default) | mjpeg_url (future blimp camera) | file (recorded clips)
VIDEO_SOURCE=webcam
# Required only when VIDEO_SOURCE=mjpeg_url
VIDEO_URL=
# Required only when VIDEO_SOURCE=file
VIDEO_FILE=

# -------------------------------------------------------------------- Server
MEEMOO_HOST=127.0.0.1
MEEMOO_PORT=8000

# ------------------------------------------------------------------- Logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = JSON lines (machines); false = human console
LOG_JSON=false
